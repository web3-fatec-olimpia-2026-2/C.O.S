# =====================================================================
# EXEMPLO DE VARIÁVEIS DE AMBIENTE
# =====================================================================
# COPIE este arquivo para .env e preencha os valores reais.
#
#   cp .env.example .env
#
# NUNCA commite o .env real - ele está no .gitignore por segurança.
# Se você commitar por engano, AVISE o professor IMEDIATAMENTE.
# =====================================================================

# ---------- Django Core ----------
# Gerar nova chave: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=troque-por-uma-chave-secreta-forte-de-pelo-menos-50-caracteres

# True apenas em desenvolvimento local. NUNCA True em produção.
DEBUG=True

# Domínios permitidos separados por vírgula
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------- Banco de Dados ----------
# Em desenvolvimento: SQLite (padrão)
DATABASE_URL=sqlite:///db.sqlite3

# Em produção (Railway/Render/Fly): usar postgres
# DATABASE_URL=postgres://usuario:senha@host:5432/nomedb

# ---------- MongoDB Atlas (a partir da Aula 7) ----------
# Obter em https://cloud.mongodb.com > seu cluster > Connect
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/
MONGODB_DATABASE=grupo_xx_projeto

# ---------- APIs Externas ----------
# Exemplo: OpenWeather (obter em https://openweathermap.org/api)
OPENWEATHER_API_KEY=

# Exemplo: outras integrações
VIACEP_URL=https://viacep.com.br/ws/

# ---------- JWT ----------
# Duração dos tokens (em minutos/dias)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ---------- E-mail (opcional) ----------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# ---------- Deploy ----------
# Se usar Railway/Render, essas variáveis são preenchidas automaticamente
# PORT=8000
